<mxfile host="app.diagrams.net" agent="hei-ddd-ai-lite" version="22.1.0">
  <diagram id="events" name="事件链路">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="领域事件链路：register → save → pull → publish" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="260" y="20" width="480" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="c" value="Controller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="ApplicationService&#xa;@Transactional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="fac" value="Factory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="500" y="40" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="agg" value="AggregateRoot&#xa;registerEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="500" y="120" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="repo" value="Repository.save" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="500" y="220" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="pub" value="DomainEventPublisher&#xa;publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="Command" style="endArrow=block;html=1;" edge="1" parent="1" source="c" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="create" style="endArrow=block;html=1;" edge="1" parent="1" source="app" target="fac"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="new + event" style="endArrow=block;html=1;" edge="1" parent="1" source="fac" target="agg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="save" style="endArrow=block;html=1;" edge="1" parent="1" source="app" target="repo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="pullDomainEvents" style="endArrow=block;html=1;" edge="1" parent="1" source="app" target="agg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="publish" style="endArrow=block;html=1;" edge="1" parent="1" source="app" target="pub"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="事务边界在应用服务；持久化成功后再拉取并发布事件" style="text;html=1;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="200" y="320" width="520" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
